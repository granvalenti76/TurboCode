{
  "manifestVersion": 1,
  "id": "status-card",
  "name": "Status Card",
  "version": "0.1.0",
  "entrypoint": "dist/index.js",
  "runtime": { "kind": "node", "node": ">=24.0.0" },
  "tools": [
    {
      "name": "openStatusCard",
      "description": "Open a card showing a title, message, and status tone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "message": { "type": "string" },
          "tone": { "type": "string", "enum": ["info", "success", "warning", "error"] }
        },
        "required": ["title", "message"],
        "additionalProperties": false
      }
    }
  ],
  "widgets": [
    {
      "id": "status-card",
      "title": "Status Card",
      "entrypoint": "widget.html",
      "description": "A compact status card rendered from tool props."
    }
  ]
}

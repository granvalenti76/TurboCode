{
  "manifestVersion": 1,
  "id": "echo-tool",
  "name": "Echo Tool",
  "version": "0.1.0",
  "entrypoint": "dist/index.js",
  "runtime": { "kind": "node", "node": ">=24.0.0" },
  "tools": [
    {
      "name": "echo",
      "description": "Echo one string.",
      "inputSchema": {
        "type": "object",
        "properties": { "value": { "type": "string" } },
        "required": ["value"],
        "additionalProperties": false
      }
    }
  ],
  "widgets": []
}
